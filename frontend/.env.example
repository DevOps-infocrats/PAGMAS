# live (default): talk to the Python backend through the /api rewrite.
# mock: generated demo data only, no backend needed.
NEXT_PUBLIC_API_MODE=live

# Server-side only: where the FastAPI backend listens.
BACKEND_URL=http://127.0.0.1:8010

# Mock mode only – demo accounts checked server-side by /demo-auth (never sent to the browser).
# Copy into .env.local and choose your own passwords (min. 8 characters).
# DEMO_USERS=[{"email":"admin@demo.local","password":"choose-a-password","name":"Demo Admin","role":"admin"},{"email":"viewer@demo.local","password":"choose-another","name":"Demo Viewer","role":"viewer"}]
