# Copy to .env (or run: python scripts/generate_env.py). Never commit .env.
APP_ENV=development            # production enables HSTS, secure cookies and hides /docs

# ---- JWT session tokens -------------------------------------------------------
SECRET_KEY=change-me-run-scripts-generate_env.py   # >= 32 random chars (generate_env.py makes 64)
# SECRET_KEY_PREVIOUS=          # set to the old key while rotating SECRET_KEY; remove after SESSION_TTL_MINUTES
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_ISSUER=pratap-api
JWT_AUDIENCE=pratap-dashboard
SESSION_TTL_MINUTES=480

# ---- Administrator login (created on start-up if missing) ---------------------
# Prefer the hash: python scripts/hash_password.py  (prints ADMIN_PASSWORD_HASH=...)
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=               # plain alternative for development only (rejected in production)
ADMIN_SYNC_PASSWORD=false      # true = reset the existing admin's password to the value above (revokes sessions)

# ---- Login protection ----------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5           # per e-mail + IP per window (per IP, any e-mail: 4x)
LOGIN_ACCOUNT_MAX_ATTEMPTS=50  # per e-mail from all IPs together per window (backstop)
LOGIN_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=30

# ---- HTTP ----------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pratap   (default: SQLite in var/app.db)
# Production refuses to start with localhost-only CORS_ORIGINS, "testserver" in TRUSTED_HOSTS or COOKIE_SECURE=false.
CORS_ORIGINS=["http://localhost:3000"]   # production: the public https origin of the dashboard
TRUSTED_HOSTS=["localhost","127.0.0.1"]
# COOKIE_SECURE=                # default: true in production, false otherwise
# Proxies whose X-Forwarded-For is trusted (IPs or CIDRs): the Next.js server, plus nginx if it runs elsewhere.
# The client IP is the rightmost X-Forwarded-For entry that is not one of these (left entries can be forged),
# so nginx must append ($proxy_add_x_forwarded_for) and Next.js must pass the header through.
# If uvicorn runs with --proxy-headers, give it the same list: --forwarded-allow-ips "127.0.0.1,::1"
TRUSTED_PROXIES=["127.0.0.1","::1"]
UPLOAD_MAX_MB=60               # workbook upload only; every other request body is limited to 64 KB
REPORT_TIMEZONE=Asia/Kolkata   # timestamps on the PPT / PDF reports

# ---- Outgoing mail (SMTP) ------------------------------------------------------
# Used by Administration → Mail Configuration ("Send Test Mail" and the scheduled AMC Conversion e-mails).
# Wrong or missing values never stop the API: sending is refused and the problem is shown on that page.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587                  # 587 with MAIL_USE_TLS=True (STARTTLS) · 465 with MAIL_USE_SSL=True
MAIL_USE_SSL=False             # implicit TLS – never together with MAIL_USE_TLS
MAIL_USE_TLS=True              # STARTTLS
MAIL_USERNAME=sender@example.com
MAIL_PASSWORD=change-me        # quote it if it contains # & or spaces: MAIL_PASSWORD='p&ss word'
MAIL_DEFAULT_SENDER=noreply@example.com
SMTP_APPROVAL_EMAILS_ENABLED=False   # reserved for approval e-mails; does NOT switch the AMC report e-mails
AMC_REPORT_EMAILS_ENABLED=False      # master switch of the scheduled AMC Conversion e-mails (off by default)
MAIL_TIMEZONE=Asia/Kolkata           # send times of the schedules are in this timezone
# MAIL_TIMEOUT_SECONDS=20

# ---- Business rules ------------------------------------------------------------
PENALTY_THRESHOLD=90
HEALTHY_THRESHOLD=98
