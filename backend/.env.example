# Copy to .env (or run: python scripts/generate_env.py). Never commit .env.
APP_ENV=development            # production enables HSTS, secure cookies and hides /docs

# ---- JWT session tokens -------------------------------------------------------
SECRET_KEY=change-me-run-scripts-generate_env.py   # >= 32 random chars (generate_env.py makes 64)
# SECRET_KEY_PREVIOUS=          # set to the old key while rotating SECRET_KEY; remove after SESSION_TTL_MINUTES
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_ISSUER=pratap-api
JWT_AUDIENCE=pratap-dashboard
SESSION_TTL_MINUTES=480

# ---- Administrator login (created on start-up if missing) ---------------------
# Prefer the hash: python scripts/hash_password.py  (prints ADMIN_PASSWORD_HASH=...)
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=               # plain alternative for development only (rejected in production)
ADMIN_SYNC_PASSWORD=false      # true = reset the existing admin's password to the value above (revokes sessions)

# ---- Login protection ----------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5           # per account per window (per IP: 4x)
LOGIN_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=30

# ---- HTTP ----------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pratap   (default: SQLite in var/app.db)
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_PROXIES=["127.0.0.1","::1"]
UPLOAD_MAX_MB=60

# ---- Business rules ------------------------------------------------------------
PENALTY_THRESHOLD=90
HEALTHY_THRESHOLD=98
